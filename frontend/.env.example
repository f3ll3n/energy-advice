# --- Клиентские переменные (собираются в бандл, доступны в браузере) ---
# Нужны только если хочешь направить фронтенд на отдельный бэкенд
# (например, локальный Express из /backend). Для деплоя на Vercel не нужна —
# api/ живёт на том же домене, и запросы идут по относительному пути /api/...
# VITE_API_URL=http://localhost:4000

# --- Серверные переменные (нужны функциям в api/, в браузер не попадают) ---
# Для локальной разработки через `vercel dev` положи их в .env в этой же папке.
# Для продакшена задай их в Vercel: Project Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/energy-advice?retryWrites=true&w=majority
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-too
